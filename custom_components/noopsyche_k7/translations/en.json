{
  "title": "Noo-Psyche K7",
  "config": {
    "step": {
      "user": {
        "title": "Connect to a Noo-Psyche K7",
        "description": "Enter the fixed LAN address of the light.",
        "data": {
          "host": "Host or IP address",
          "port": "TCP port"
        }
      }
    },
    "error": {
      "cannot_connect": "Unable to connect to the light",
      "invalid_response": "The device returned an unsupported response",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This light is already configured"
    }
  },
  "entity": {
    "light": { "manual_output": { "name": "Manual output" } },
    "number": {
      "white": { "name": "White" },
      "royal_blue": { "name": "Royal blue" },
      "green": { "name": "Green" },
      "uv": { "name": "UV" },
      "blue": { "name": "Blue" },
      "red": { "name": "Red" }
    },
    "select": {
      "operating_mode": {
        "name": "Operating mode",
        "state": { "auto": "Automatic", "manual": "Manual" }
      }
    },
    "button": { "sync_time": { "name": "Synchronize time" } },
    "switch": { "demonstration": { "name": "Demonstration" } },
    "sensor": { "schedule": { "name": "Schedule" } }
  },
  "services": {
    "get_schedule": {
      "name": "Get schedule",
      "description": "Return the manual values, mode, and stored schedule.",
      "fields": { "config_entry_id": { "name": "Configuration entry" } }
    },
    "get_profile": {
      "name": "Get factory profile",
      "description": "Return an official-app profile without writing it to the light.",
      "fields": { "profile": { "name": "Profile" } }
    },
    "set_schedule": {
      "name": "Set schedule",
      "description": "Overwrite the light's stored 24-point schedule.",
      "fields": {
        "config_entry_id": { "name": "Configuration entry" },
        "schedule": { "name": "Schedule" },
        "manual": { "name": "Manual channel values" },
        "auto_mode": { "name": "Enable automatic mode" }
      }
    },
    "apply_profile": {
      "name": "Apply factory profile",
      "description": "Overwrite the stored schedule with an official-app factory profile.",
      "fields": {
        "config_entry_id": { "name": "Configuration entry" },
        "profile": { "name": "Profile" },
        "auto_mode": { "name": "Enable automatic mode" }
      }
    },
    "preview": {
      "name": "Preview channel output",
      "description": "Send six temporary preview channel values without saving the schedule.",
      "fields": {
        "config_entry_id": { "name": "Configuration entry" },
        "channels": { "name": "Channels" }
      }
    },
    "sync_time": {
      "name": "Set light time",
      "description": "Set an explicit hour, minute, and second on the light.",
      "fields": {
        "config_entry_id": { "name": "Configuration entry" },
        "hour": { "name": "Hour" },
        "minute": { "name": "Minute" },
        "second": { "name": "Second" }
      }
    }
  },
  "selector": {
    "profile": {
      "options": {
        "sps": "SPS",
        "lps": "LPS",
        "mixed": "SPS/LPS mixed"
      }
    }
  }
}
