        "auto_mode": { "name": "Enable automatic mode" }
      }
    },
    "apply_profile": {
      "name": "Apply factory profile",
      "description": "Overwrite the stored schedule with an official-app factory profile.",
      "fields": {
        "config_entry_id": { "name": "Configuration entry" },
        "profile": { "name": "Profile" },
        "auto_mode": { "name": "Enable automatic mode" }
      }
    }
  },
  "selector": {
    "profile": {
      "options": {
        "sps": "SPS",
        "lps": "LPS",
        "mixed": "SPS/LPS mixed"
      }
    }
  }
